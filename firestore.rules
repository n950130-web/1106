// ===============================================================
// Assumed Data Model
// ===============================================================
// Collection: users
// Document ID: Firebase Authentication UID
// Fields:
//   - items: required list, at most 200 entries. The app stores task/event
//     maps here (id, title, kind, date, time, priority, done, and optional
//     reminder fields). Ownership is derived from the document path.
//
// The current client stores all items in one array. Firestore Rules cannot
// iterate over list elements, so these prototype rules validate the document
// envelope and list size, while the 1 MiB document limit still applies.
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner(userId) {
      return isOwner(userId);
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) &&
        !('uid' in resource.data);
    }

    function isValidUser(data) {
      return data is map &&
        data.keys().hasAll(['items']) &&
        data.keys().hasOnly(['items']) &&
        data.items is list &&
        data.items.size() <= 200;
    }

    match /users/{userId} {
      allow get: if isDocOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
        uidUnchanged() &&
        isValidUser(request.resource.data);
      allow update: if isOwner(userId) &&
        uidNotModified() &&
        isValidUser(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
